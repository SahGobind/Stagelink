# StageLink Frontend Environment Variables Example
VITE_APP_NAME=StageLink
VITE_APP_ENV=development

# Backend API Base URL
# Leave blank in local development to utilize Vite proxy.
# Set to your live Render backend URL in production (e.g., on Vercel):
# VITE_API_BASE_URL=https://stagelink-wg25.onrender.com
VITE_API_BASE_URL=

