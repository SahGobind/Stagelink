# StarCast Backend Environment Configuration (Database-free / In-Memory)
DJANGO_SECRET_KEY=your-production-secret-key-here-min-50-characters
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated). For Render, RENDER_EXTERNAL_HOSTNAME and *.onrender.com are auto-included.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Configuration (comma-separated). Allow Vercel frontend and local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://stagelink-nv45.vercel.app
CORS_ALLOW_ALL_ORIGINS=False

# CSRF Trusted Origins (comma-separated, include scheme https://)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://*.vercel.app,https://*.onrender.com

# Service Configurations (in-memory mode, placeholders)
JWT_SECRET_KEY=your-jwt-secret-placeholder
PAYMENT_GATEWAY_SANDBOX=True
PAYMENT_API_KEY=test_starcast_mock_key
