# MongoDB Atlas Configuration
# Note: Username and password must be URL-encoded (e.g. user%40domain:pass%23word)
MONGODB_URI=mongodb+srv://<URL_ENCODED_USERNAME>:<URL_ENCODED_PASSWORD>@cluster0.xudonxw.mongodb.net/?retryWrites=true&w=majority&appName=StageLink
MONGODB_DB_NAME=stagelink_db

# Django Core Settings
DJANGO_SECRET_KEY=replace_with_a_secure_secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend URL (for CORS and redirects)
# FRONTEND_URL=http://localhost:5173
FRONTEND_URL=https://stagelink-wg25.onrender.com

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://stagelink-nv45.vercel.app
CORS_ALLOW_ALL_ORIGINS=False

# CSRF Trusted Origins (comma-separated, include scheme https://)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://*.vercel.app,https://*.onrender.com

# Service Configurations
JWT_SECRET_KEY=replace_with_a_secure_jwt_secret
PAYMENT_GATEWAY_SANDBOX=True
PAYMENT_API_KEY=test_starcast_mock_key

